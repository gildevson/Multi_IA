<UserControl x:Class="Jarvis.Desktop.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Jarvis.Desktop.Converters"
             xmlns:helpers="clr-namespace:Jarvis.Desktop.Helpers"
             xmlns:controls="clr-namespace:Jarvis.Desktop.Controls"
             xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:Base64ToImageConverter x:Key="Base64ToImage"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <converters:MessageRoleToColorConverter x:Key="RoleToColor"/>
        <converters:MessageRoleToAlignmentConverter x:Key="RoleToAlignment"/>
        <converters:MarkdownSegmentsConverter x:Key="MarkdownToSegments"/>
        <converters:LanguageToLabelConverter x:Key="LangToLabel"/>
        <converters:InlineMarkdownConverter x:Key="InlineMarkdown"/>
        <converters:PathToImageSourceConverter x:Key="PathToImageSource"/>

        <!-- DataTemplate para blocos de CÓDIGO -->
        <DataTemplate DataType="{x:Type helpers:MarkdownSegment}" x:Key="CodeSegmentTemplate">
            <Border Background="#1E1F29" BorderBrush="#44475A" BorderThickness="1"
                    CornerRadius="6" Margin="0,4,0,4">
                <!-- Header do bloco de código -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de título com linguagem e botão copiar -->
                    <Border Grid.Row="0" Background="#282A36" CornerRadius="6,6,0,0"
                            BorderBrush="#44475A" BorderThickness="0,0,0,1"
                            Padding="12,6">
                        <Grid>
                            <TextBlock Text="{Binding Language, Converter={StaticResource LangToLabel}}"
                                       Foreground="#6272A4" FontFamily="Consolas" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <Button Content="⎘ Copy" HorizontalAlignment="Right"
                                    Tag="{Binding Text}"
                                    Click="CopyCodeBlock_Click"
                                    Foreground="#6272A4" Background="Transparent"
                                    BorderThickness="0" FontFamily="Consolas" FontSize="11"
                                    Cursor="Hand" Padding="4,2">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#6272A4"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            CornerRadius="3">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#44475A"/>
                                                            <Setter Property="Foreground" Value="#F8F8F2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Conteúdo do código com syntax highlight Dracula -->
                    <controls:SyntaxHighlightedCode Grid.Row="1"
                                                    Code="{Binding Text}"
                                                    Language="{Binding Language}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- DataTemplate para texto normal com Markdown estilizado Dracula -->
        <DataTemplate DataType="{x:Type helpers:MarkdownSegment}" x:Key="TextSegmentTemplate">
            <ItemsControl ItemsSource="{Binding Text, Converter={StaticResource InlineMarkdown}}"
                          Focusable="False"/>
        </DataTemplate>

        <!-- Selector de template -->
        <converters:SegmentTemplateSelector x:Key="SegmentSelector"
            CodeTemplate="{StaticResource CodeSegmentTemplate}"
            TextTemplate="{StaticResource TextSegmentTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Imagem de fundo do chat (configurável) -->
        <Image Grid.Row="0" Grid.RowSpan="3"
               Source="{Binding ChatBackgroundImagePath, Converter={StaticResource PathToImageSource}}"
               Opacity="{Binding ChatBackgroundOpacity}"
               Stretch="UniformToFill"
               IsHitTestVisible="False"/>

        <!-- Messages List + Typing indicator -->
        <ScrollViewer Grid.Row="0" x:Name="MessagesScroller"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16,8">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,4"
                                    MaxWidth="760"
                                    HorizontalAlignment="{Binding Role, Converter={StaticResource RoleToAlignment}}"
                                    Background="{Binding Role, Converter={StaticResource RoleToColor}}"
                                    BorderBrush="#0F3460" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Role}"
                                               Foreground="{StaticResource HighlightBrush}"
                                               FontSize="10" FontFamily="Consolas"
                                               FontWeight="Bold" Margin="0,0,0,4"/>

                                    <!-- Imagem anexada (se houver) -->
                                    <Image Source="{Binding ImageBase64, Converter={StaticResource Base64ToImage}}"
                                           Visibility="{Binding ImageBase64, Converter={StaticResource NullToVisibility}}"
                                           MaxHeight="260" MaxWidth="400"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,6"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <!-- Renderer de segmentos (texto + código) -->
                                    <ItemsControl ItemsSource="{Binding Content, Converter={StaticResource MarkdownToSegments}}"
                                                  ItemTemplateSelector="{StaticResource SegmentSelector}"/>

                                    <!-- Rodapé: hora + botão copiar (visível só no Assistant) -->
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Text="{Binding CreatedAt, StringFormat=HH:mm:ss}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="9" FontFamily="Consolas"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                        <Button Content="📋 Copiar"
                                                Tag="{Binding Content}"
                                                Click="CopyMessage_Click"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="10" FontFamily="Consolas"
                                                Padding="6,3" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#6272A4"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="3"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#282A36"/>
                                                                        <Setter Property="Foreground" Value="#F8F8F2"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="Assistant">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Typing indicator — aparece logo após a última mensagem -->
                <Border Visibility="{Binding IsThinking, Converter={StaticResource BoolToVisibility}}"
                        Margin="4,4,4,4"
                        HorizontalAlignment="Left"
                        Background="{StaticResource AssistantMessageBrush}"
                        BorderBrush="#0F3460" BorderThickness="1"
                        CornerRadius="12,12,12,2"
                        Padding="16,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="20">

                        <!-- Bolinha 1 -->
                        <Ellipse Width="9" Height="9" Margin="0,0,5,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#E94560"/>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="Dot1T"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Dot1T"
                                                             Storyboard.TargetProperty="Y"
                                                             From="0" To="-7"
                                                             Duration="0:0:0.45"
                                                             AutoReverse="True"
                                                             BeginTime="0:0:0">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <!-- Bolinha 2 -->
                        <Ellipse Width="9" Height="9" Margin="0,0,5,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#E94560" Opacity="0.8"/>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="Dot2T"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Dot2T"
                                                             Storyboard.TargetProperty="Y"
                                                             From="0" To="-7"
                                                             Duration="0:0:0.45"
                                                             AutoReverse="True"
                                                             BeginTime="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <!-- Bolinha 3 -->
                        <Ellipse Width="9" Height="9">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#E94560" Opacity="0.6"/>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="Dot3T"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Dot3T"
                                                             Storyboard.TargetProperty="Y"
                                                             From="0" To="-7"
                                                             Duration="0:0:0.45"
                                                             AutoReverse="True"
                                                             BeginTime="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Recording Indicator -->
        <Border Grid.Row="1"
                Visibility="{Binding IsListening, Converter={StaticResource BoolToVisibility}}"
                Background="#1A0510" BorderBrush="#E94560" BorderThickness="1"
                Padding="16,6" Margin="16,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🎤" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Canvas Width="60" Height="28" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Rectangle x:Name="Bar1" Canvas.Left="0"  Canvas.Top="14" Width="6" Height="14" Fill="#E94560" RadiusX="3" RadiusY="3"/>
                    <Rectangle x:Name="Bar2" Canvas.Left="9"  Canvas.Top="8"  Width="6" Height="20" Fill="#E94560" RadiusX="3" RadiusY="3"/>
                    <Rectangle x:Name="Bar3" Canvas.Left="18" Canvas.Top="4"  Width="6" Height="24" Fill="#FF6B8A" RadiusX="3" RadiusY="3"/>
                    <Rectangle x:Name="Bar4" Canvas.Left="27" Canvas.Top="10" Width="6" Height="18" Fill="#E94560" RadiusX="3" RadiusY="3"/>
                    <Rectangle x:Name="Bar5" Canvas.Left="36" Canvas.Top="4"  Width="6" Height="24" Fill="#E94560" RadiusX="3" RadiusY="3"/>
                    <Rectangle x:Name="Bar6" Canvas.Left="45" Canvas.Top="8"  Width="6" Height="20" Fill="#FF6B8A" RadiusX="3" RadiusY="3"/>
                    <Rectangle x:Name="Bar7" Canvas.Left="54" Canvas.Top="14" Width="6" Height="14" Fill="#E94560" RadiusX="3" RadiusY="3"/>
                    <Canvas.Triggers>
                        <EventTrigger RoutedEvent="Canvas.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="Height" From="4" To="26" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.0"/>
                                    <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="(Canvas.Top)" From="24" To="2" Duration="0:0:0.4" AutoReverse="True" BeginTime="0:0:0.0"/>
                                    <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="Height" From="8" To="28" Duration="0:0:0.3" AutoReverse="True" BeginTime="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="(Canvas.Top)" From="20" To="0" Duration="0:0:0.3" AutoReverse="True" BeginTime="0:0:0.1"/>
                                    <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="Height" From="14" To="28" Duration="0:0:0.5" AutoReverse="True" BeginTime="0:0:0.05"/>
                                    <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="(Canvas.Top)" From="14" To="0" Duration="0:0:0.5" AutoReverse="True" BeginTime="0:0:0.05"/>
                                    <DoubleAnimation Storyboard.TargetName="Bar4" Storyboard.TargetProperty="Height" From="4" To="22" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Bar4" Storyboard.TargetProperty="(Canvas.Top)" From="24" To="6" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="Bar5" Storyboard.TargetProperty="Height" From="10" To="28" Duration="0:0:0.45" AutoReverse="True" BeginTime="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="Bar5" Storyboard.TargetProperty="(Canvas.Top)" From="18" To="0" Duration="0:0:0.45" AutoReverse="True" BeginTime="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetName="Bar6" Storyboard.TargetProperty="Height" From="6" To="24" Duration="0:0:0.38" AutoReverse="True" BeginTime="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="Bar6" Storyboard.TargetProperty="(Canvas.Top)" From="22" To="4" Duration="0:0:0.38" AutoReverse="True" BeginTime="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="Bar7" Storyboard.TargetProperty="Height" From="4" To="20" Duration="0:0:0.42" AutoReverse="True" BeginTime="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetName="Bar7" Storyboard.TargetProperty="(Canvas.Top)" From="24" To="8" Duration="0:0:0.42" AutoReverse="True" BeginTime="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Canvas.Triggers>
                </Canvas>
                <TextBlock Text="OUVINDO... (clique 🎤 para parar)"
                           Foreground="#E94560"
                           FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Input Area -->
        <Border Grid.Row="2" Background="{StaticResource PrimaryBrush}"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <StackPanel>
                <TextBlock Text="{Binding CurrentModel}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Consolas" FontSize="10"
                           Margin="0,0,0,4"/>

                <!-- Preview da imagem pendente -->
                <Border Visibility="{Binding HasPendingImage, Converter={StaticResource BoolToVisibility}}"
                        Background="#1A1A2E" CornerRadius="6"
                        Padding="8,6" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0"
                               Source="{Binding PendingImageBase64, Converter={StaticResource Base64ToImage}}"
                               Height="48" Width="48" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                                <RectangleGeometry RadiusX="4" RadiusY="4" Rect="0,0,48,48"/>
                            </Image.Clip>
                        </Image>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PendingImagePath}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Consolas" FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="8,0"/>
                        <Button Grid.Column="2" Content="✕"
                                Style="{StaticResource JarvisButton}"
                                Command="{Binding RemoveImageCommand}"
                                FontSize="11" Padding="6,4"/>
                    </Grid>
                </Border>

                <!-- Preview do PDF pendente -->
                <Border Visibility="{Binding HasPendingPdf, Converter={StaticResource BoolToVisibility}}"
                        Background="#1A1A2E" CornerRadius="6"
                        Padding="8,6" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📄"
                                   FontSize="28" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PendingPdfFileName}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="PDF pronto para envio"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="Consolas" FontSize="10"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="✕"
                                Style="{StaticResource JarvisButton}"
                                Command="{Binding RemovePdfCommand}"
                                FontSize="11" Padding="6,4"/>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Botão único Anexar com dropdown -->
                    <Button Grid.Column="0" x:Name="AttachButton"
                            Style="{StaticResource JarvisButton}"
                            Click="AttachButton_Click"
                            Padding="10,6" Margin="0,0,4,0"
                            ToolTip="Anexar imagem ou PDF">
                        <Button.ContextMenu>
                            <ContextMenu FontFamily="Consolas" FontSize="13"
                                         Background="#1E1F29" BorderBrush="#44475A"
                                         BorderThickness="1" HasDropShadow="True">
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Background="#1E1F29"
                                                BorderBrush="#44475A"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                SnapsToDevicePixels="True">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.5" Color="Black"/>
                                            </Border.Effect>
                                            <StackPanel IsItemsHost="True"/>
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Foreground" Value="#F8F8F2"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Padding" Value="14,9"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            CornerRadius="3">
                                                        <ContentPresenter ContentSource="Header"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#44475A"/>
                                                            <Setter Property="Foreground" Value="#8BE9FD"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="📎  Imagem"
                                          Command="{Binding PlacementTarget.DataContext.AttachImageCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="📄  PDF"
                                          Command="{Binding PlacementTarget.DataContext.AttachPdfCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📎" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Anexar ▲" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBox Grid.Column="1"
                             Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource JarvisTextBox}"
                             FontFamily="Consolas" FontSize="13"
                             VerticalContentAlignment="Center"
                             Margin="0,0,8,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <!-- Botão cancelar resposta — aparece quando está pensando -->
                    <Button Grid.Column="2" Content="⏹ Cancelar"
                            Command="{Binding CancelResponseCommand}"
                            FontSize="12" Padding="10,6" Margin="0,0,4,0"
                            ToolTip="Cancelar resposta">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource JarvisButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Background" Value="#3A1010"/>
                                <Setter Property="Foreground" Value="#E94560"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThinking}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Botão parar fala — aparece apenas quando está falando -->
                    <Button Grid.Column="2" Content="⏹"
                            Command="{Binding StopSpeakingCommand}"
                            FontSize="14" Padding="10,6" Margin="0,0,4,0"
                            ToolTip="Parar fala">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource JarvisButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Background" Value="#3A1010"/>
                                <Setter Property="Foreground" Value="#E94560"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="3"
                            Style="{StaticResource JarvisButton}"
                            Command="{Binding ToggleVoiceCommand}"
                            FontSize="16" Padding="10,6" Margin="0,0,4,0"
                            ToolTip="Resposta em áudio (digitando ou por voz)">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="🔇"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VoiceEnabled}" Value="True">
                                            <Setter Property="Text" Value="🔊"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Grid.Column="4" Content="🎤"
                            Style="{StaticResource JarvisButton}"
                            Command="{Binding StartListeningCommand}"
                            FontSize="16" Padding="12,6" Margin="0,0,4,0"/>
                    <Button Grid.Column="5" Content="🔍"
                            Style="{StaticResource JarvisButton}"
                            Command="{Binding SearchAndSendCommand}"
                            FontSize="15" Padding="10,6" Margin="0,0,4,0"
                            ToolTip="Pesquisar na internet e responder"/>
                    <Button Grid.Column="6" Content="Send ▶"
                            Style="{StaticResource JarvisButton}"
                            Command="{Binding SendMessageCommand}"
                            Margin="0,0,4,0"
                            ToolTip="Enviar mensagem"/>
                    <Button Grid.Column="7" Content="🗑"
                            Style="{StaticResource JarvisButton}"
                            Command="{Binding ClearConversationCommand}"
                            FontSize="14" Padding="10,6"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
