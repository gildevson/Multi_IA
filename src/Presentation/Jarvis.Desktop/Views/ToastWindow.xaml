<Window x:Class="Jarvis.Desktop.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="320" Height="76"
        IsHitTestVisible="True">

    <Border Background="#1A1A2E"
            BorderBrush="#E94560"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="⬡" Foreground="#E94560" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="J.A.R.V.I.S." Foreground="#E94560"
                           FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="MessageText"
                       Foreground="#D4D4D4"
                       FontFamily="Consolas" FontSize="12"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Border>
</Window>
